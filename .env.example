# Nusxa oling: cp .env.example .env, keyin haqiqiy qiymatlarni to'ldiring.
# .env fayl git'ga HECH QACHON qo'shilmaydi (.gitignore'da).

# --- Postgres ---
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_strong_password

# --- Backend JWT ---
# Kamida 256 bit (32+ belgi) tasodifiy qiymat. Masalan: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_random_characters

# --- Frontend build-vaqtidagi API manzili ---
# Lokal test: http://localhost:8095
# Serverda (Cloudflare tunnel ulangandan keyin): https://savdo-api.ecos.uz
VITE_API_BASE_URL=http://localhost:8095

# --- CORS (backend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3010

# --- Cloudflare Tunnel (7-bosqichgacha bo'sh qoladi - foydalanuvchi
# Cloudflare Zero Trust panelida savdo.ecos.uz/savdo-api.ecos.uz uchun
# YANGI tunnel yaratib, tokenini shu yerga qo'yishi kerak) ---
CLOUDFLARE_TUNNEL_TOKEN=
